# Browser / Next.js
NEXT_PUBLIC_CONVEX_URL=https://your-deployment.convex.cloud
NEXT_PUBLIC_CONVEX_SITE_URL=https://your-deployment.convex.site
AUTH_SECRET=replace-with-a-random-authjs-secret
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Auth.js -> Convex JWT bridge. Generate offline; never commit the private key.
AUTH_JWT_ISSUER=https://your-app.example.com
AUTH_JWT_KEY_ID=pipelixr-foundation-1
AUTH_JWT_PRIVATE_KEY=base64-pkcs8-private-key
AUTH_JWT_JWKS=https://your-app.example.com/api/auth/jwks

# Keep false until the deployed Evolution Go contract is qualified.
FOUNDATION_PROVIDER_ENABLED=false
FOUNDATION_PROVIDER_CONTRACT_VERIFIED=false
EVOLUTION_GO_URL=https://evolution-go.example.com
EVOLUTION_GO_API_KEY=replace-with-global-key
EVOLUTION_GO_AUTH_MODE=instance-token
ALLOW_LOCAL_PROVIDER_HTTP=false
CONVEX_SITE_URL=https://your-deployment.convex.site

# Independent base64-encoded 32-byte keys. Retain old versions during rotation.
SESSION_ENCRYPTION_KEYS={"v1":"base64-32-byte-key"}
SESSION_ENCRYPTION_KEY_VERSION=v1
IDENTITY_HASH_KEY=base64-32-byte-key

# Optional bounded policy overrides.
FOUNDATION_MAX_WEBHOOK_BYTES=262144
FOUNDATION_MAX_TEXT_LENGTH=16000
FOUNDATION_RETRY_ATTEMPTS=5
FOUNDATION_RETRY_BASE_MS=2000
FOUNDATION_JOB_LEASE_MS=60000
FOUNDATION_BATCH_SIZE=50
FOUNDATION_MESSAGE_RETENTION_DAYS=90
FOUNDATION_EVENT_RETENTION_DAYS=7
FOUNDATION_QR_LIFETIME_MS=120000
FOUNDATION_PROVIDER_TIMEOUT_MS=10000
FOUNDATION_HEALTH_INTERVAL_MS=300000
FOUNDATION_AUTH_WINDOW_MS=900000
FOUNDATION_AUTH_ACCOUNT_LIMIT=10
FOUNDATION_AUTH_GLOBAL_LIMIT=200
PHASE2_RESPONSE_WINDOW_MINUTES=120

# Phase 3 suggest-first policy. These govern task availability, not sending.
PHASE3_COOLDOWN_MINUTES=1440
PHASE3_DAILY_SUGGESTION_CAP=20
PHASE3_WORK_HOURS_START=540
PHASE3_WORK_HOURS_END=1260
PHASE3_QUIET_HOURS_START=1260
PHASE3_QUIET_HOURS_END=480
PHASE3_SUGGESTION_MAX_LENGTH=500
PHASE3_AI_TIMEOUT_MS=8000

# AI requires both this deployment flag and an explicit per-business setting.
# Keep false unless the model/key are configured and reviewed.
PHASE3_AI_SUGGESTIONS_ENABLED=false
GROQ_API_KEY=
GROQ_LLM_MODEL=

# Phase 4 seller-action timing. These create deferred suggestions only.
PHASE4_STALLED_OPPORTUNITY_MINUTES=360
PHASE4_PAYMENT_REMINDER_MINUTES=1440

# Phase 5 conservative measurement bounds.
PHASE5_ATTRIBUTION_WINDOW_DAYS=7
PHASE5_DASHBOARD_RECORD_LIMIT=1000

# Phase 6 read-only risk warning thresholds. These never enable sending.
PHASE6_RISK_WINDOW_HOURS=24
PHASE6_RISK_WARNING_COUNT=5
